rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors the ADMIN_EMAILS constant used client-side (header.tsx, admin API routes).
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email in
        ['contactcyba@gmail.com', 'z1mmerman@yahoo.com'];
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Public profiles — anyone can view, only owner can write
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      match /coinTransactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }

      match /cashTransactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }

      // One claim doc per ad, used to cap the AD DROP watch-reward to once per
      // unique ad per user per 24h (checked client-side via a transaction).
      match /adRewardClaims/{adId} {
        allow read, write: if isOwner(userId);
      }

      // Referrals subcollection — private, owner-only
      match /referrals/{refId} {
        allow read: if isOwner(userId);
      }

      // Engagement analytics log — written only by the server (/api/log-engagement, via
      // adminDb, which bypasses these rules) since a "like this post" action logs an event
      // under the RECIPIENT's uid too, not just the actor's. No client write path at all.
      match /engagementLog/{eventId} {
        allow read: if isOwner(userId);
      }
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn();
    }

    // ── Posts & Comments ─────────────────────────────────────────────────────
    // Public feed — anyone can read
    match /cybazone_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    // ── Quest Submissions ────────────────────────────────────────────────────
    match /quest_submissions/{subId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ── Custom Quests ────────────────────────────────────────────────────────
    match /custom_quests/{questId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Shoutouts ────────────────────────────────────────────────────────────
    match /shoutouts/{shoutoutId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // ── Presence (live user count) ───────────────────────────────────────────
    match /presence/{sessionId} {
      allow read: if isSignedIn();
      allow write: if true;
    }

    // ── Ads (AD DROP) ───────────────────────────────────────────────────────
    // Users may only create/edit/delete their own still-unpaid drafts.
    // Activation, tier/upsell flags, and expiry are server-side only (Stripe
    // webhook + cron, both using the Admin SDK, which bypasses these rules).
    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment';
      allow update: if isAdminEmail() || (isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending_payment')
        // Any signed-in viewer may bump an active ad's view/click/watch-time
        // counters from the AD DROP popup — scoped to only those 3 fields.
        || (isSignedIn() && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewCount', 'clickCount', 'totalWatchSeconds']));
      allow delete: if isAdminEmail() || (isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending_payment');
    }

    // ── Cash-out Requests ────────────────────────────────────────────────────
    match /cashout_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ── Weekly Payout History ────────────────────────────────────────────────
    match /weekly_payout_history/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Sponsored Items ──────────────────────────────────────────────────────
    match /sponsored_items/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Conversations & Messages ─────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isSignedIn() &&
        resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.participants.hasAny([request.auth.uid]);

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    // Public read so guests can see boosts, radio config, etc.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Shop / Extras / Memberships / Merchandise ────────────────────────────
    match /extras/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /memberships/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /merchandise/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Radio Boost Submissions ───────────────────────────────────────────────
    match /radio_submissions/{subId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ── Market Boost Listings ────────────────────────────────────────────────
    match /market_listings/{listingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Market Orders ────────────────────────────────────────────────────────
    match /merch_orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ── Pulses (24h ephemeral stories) ───────────────────────────────────────
    match /pulses/{pulseId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Owner can update anything (rare — mainly for future edits); any signed-in viewer may
      // only touch viewedBy, to mark a story as seen without granting broader write access.
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── Fallback ──────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
